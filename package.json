{
  "name": "outbox-email-scheduler",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "pnpm --filter @outbox/db generate",
    "db:migrate": "pnpm --filter @outbox/db migrate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "reindex": "tsx scripts/reindex.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke-test": "node --env-file=.env --import tsx scripts/smoke-test.ts",
    "load-test": "node --env-file=.env --import tsx scripts/load-test.ts"
  },
  "devDependencies": {
    "@outbox/db": "workspace:*",
    "@outbox/search": "workspace:*",
    "@outbox/shared": "workspace:*",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^22.10.2",
    "nodemailer": "^6.9.16",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
