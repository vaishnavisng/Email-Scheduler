# Copy to .env for personal overrides. Works as-is with zero edits.
#
# Two audiences:
#   - docker compose reads the ${VAR} substitutions below (ports, pg creds,
#     rate-limit knobs). It sets the service-name URLs itself, so DATABASE_URL
#     etc. here only matter when you run an app directly on the host.
#   - running an app on the host (pnpm --filter ... dev) reads these directly,
#     which is why the URLs point at localhost.

# --- Host ports (published by docker compose) ---
POSTGRES_PORT=5432
REDIS_PORT=6379
ES_PORT=9200
API_PORT=4000
WEB_PORT=3000

# --- Postgres credentials (used by the postgres container + URL below) ---
POSTGRES_USER=outbox
POSTGRES_PASSWORD=outbox
POSTGRES_DB=outbox

# --- Backing services (host view; compose overrides with service names) ---
DATABASE_URL=postgres://outbox:outbox@localhost:5432/outbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# --- Worker throughput / rate limiting ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR_GLOBAL=1000
RATE_LIMIT_WINDOW_MS=3600000
STALLED_SEND_THRESHOLD_MS=120000

# --- Ethereal SMTP (optional) ---
# Left blank, bootstrap auto-creates three test accounts via Ethereal's API on
# first boot. Set these only as an offline fallback if that API is unreachable.
ETHEREAL_USER_1=
ETHEREAL_PASS_1=
ETHEREAL_USER_2=
ETHEREAL_PASS_2=
ETHEREAL_USER_3=
ETHEREAL_PASS_3=

# --- Auth + Bull Board ---
JWT_SECRET=dev-insecure-jwt-secret-change-me
BULLBOARD_USER=admin
BULLBOARD_PASS=admin

# --- Google OAuth ---
# Create an OAuth client (https://console.cloud.google.com/apis/credentials):
#   Authorized redirect URI: http://localhost:4000/api/auth/google/callback
#   Authorized JS origin:     http://localhost:3000
# Add reviewers as test users on the consent screen (basic email/profile scopes
# don't need verification). Paste the client id/secret here; the API runs the
# whole flow and sets an httpOnly session cookie (docs/DECISIONS/0009-cookie-auth.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth (incoming-webhook scope) ---
# Create a Slack app (https://api.slack.com/apps), add redirect URL
#   http://localhost:4000/api/slack/callback  and bot scope  incoming-webhook,
# then paste its Client ID / Secret here. Committed on purpose: this repo is
# private, so reviewers can click "Connect Slack" without making their own app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# --- Web (browser-facing, localhost is correct here) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
